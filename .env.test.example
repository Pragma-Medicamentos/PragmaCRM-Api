# Copiar a .env.test para correr `npm run test:integration`.
# Debe apuntar SIEMPRE a una base de datos desechable (la instancia local de
# Supabase o un proyecto de pruebas), nunca a staging ni a produccion.
STAGE=dev
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOG_LEVEL=silent

# Integration tests do not talk to Supabase Auth (the verifier is mocked), but
# envs.ts refuses to boot without these.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=fake-service-role-key
