# Copiar a .env.test para correr `npm run test:integration`.
# Debe apuntar SIEMPRE a una base de datos desechable (la instancia local de
# Supabase o un proyecto de pruebas), nunca a staging ni a produccion.
STAGE=dev
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOG_LEVEL=silent

# Valores ficticios: la publishable key debe conservar el formato pk_test_<base64 del dominio>.
CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
CLERK_SECRET_KEY=sk_test_fake
