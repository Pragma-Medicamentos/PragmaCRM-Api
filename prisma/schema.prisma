model scheduled_visit {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  route_user_id String     @db.Uuid
  visit_date    DateTime   @db.Date
  customer_id   String?    @db.Uuid
  prospect_id   String?    @db.Uuid
  stop_type     String     @default("visit")
  reason        String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime?  @db.Timestamptz(6)
  customer      customer?  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prospect      prospect?  @relation(fields: [prospect_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  route_user    route_user @relation(fields: [route_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id, visit_date], map: "scheduled_visit_customer_date_idx", where: raw("(deleted_at IS NULL)"))
  @@index([prospect_id], where: raw("((prospect_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([route_user_id, visit_date], map: "scheduled_visit_route_user_date_idx", where: raw("(deleted_at IS NULL)"))
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
