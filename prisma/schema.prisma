/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sale {
  erp_sale_id      Int                @id
  customer_id      String?            @db.Uuid
  upload_id        String?            @db.Uuid
  user_id          String?            @db.Uuid
  visit_id         String?            @db.Uuid
  erp_created_at   DateTime?          @db.Timestamptz(6)
  last_payment_at  DateTime?          @db.Timestamptz(6)
  total            Decimal?           @db.Decimal(14, 2)
  net_total        Decimal?           @db.Decimal(14, 2)
  vat              Decimal?           @db.Decimal(14, 2)
  pending_balance  Decimal?           @db.Decimal(14, 2)
  payment          String?
  payment_id       Int?               @db.SmallInt
  erp_status       Int?               @db.SmallInt
  document         String?
  remarks          String?
  absent           Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  balance_snapshot balance_snapshot[]
  customer         customer?          @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  upload           upload?            @relation(fields: [upload_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user         app_user?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visit            visit?             @relation(fields: [visit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale_detail      sale_detail[]

  @@index([customer_id, erp_created_at], map: "sale_customer_date_idx", where: raw("(deleted_at IS NULL)"))
  @@index([erp_created_at], where: raw("(deleted_at IS NULL)"))
  @@index([customer_id, erp_created_at], map: "sale_pending_balance_idx", where: raw("((pending_balance > (0)::numeric) AND (deleted_at IS NULL))"))
  @@index([upload_id])
  @@index([user_id, erp_created_at], map: "sale_user_date_idx", where: raw("(deleted_at IS NULL)"))
  @@index([visit_id], where: raw("(deleted_at IS NULL)"))
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sale_detail {
  sale_detail_id  Int      @id
  erp_sale_id     Int
  product_id      Int?
  quantity        Decimal? @db.Decimal(12, 4)
  unit_of_measure String?
  factor          Decimal? @db.Decimal(10, 2)
  price           Decimal? @db.Decimal(14, 4)
  total           Decimal? @db.Decimal(14, 2)
  tax_total       Decimal? @db.Decimal(14, 4)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  sale            sale     @relation(fields: [erp_sale_id], references: [erp_sale_id], onDelete: Cascade, onUpdate: NoAction)
  product         product? @relation(fields: [product_id], references: [erp_product_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([erp_sale_id])
  @@index([product_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sale_staging {
  id           BigInt    @id @default(autoincrement())
  upload_id    String    @db.Uuid
  erp_sale_id  Int?
  payload      Json
  status       String    @default("pending")
  error        String?
  processed_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  upload       upload    @relation(fields: [upload_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([upload_id, status], map: "sale_staging_upload_status_idx")
}

