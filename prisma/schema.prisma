generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model app_user {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  erp_user_id     Int?              @unique(where: raw("(deleted_at IS NULL)"))
  clerk_user_id   String?           @unique(where: raw("(deleted_at IS NULL)"))
  role            String
  name            String
  email           String?
  active          Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)
  goal            goal[]
  product_request product_request[]
  prospect        prospect[]
  route_user      route_user[]
  sale            sale[]
  upload          upload[]
  visit           visit[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model balance_snapshot {
  id              BigInt   @id @default(autoincrement())
  upload_id       String?  @db.Uuid
  erp_sale_id     Int?
  pending_balance Decimal? @db.Decimal(14, 2)
  payment         String?
  captured_at     DateTime @default(now()) @db.Timestamptz(6)
  sale            sale?    @relation(fields: [erp_sale_id], references: [erp_sale_id], onDelete: NoAction, onUpdate: NoAction)
  upload          upload?  @relation(fields: [upload_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([erp_sale_id, captured_at(sort: Desc)], map: "balance_snapshot_sale_idx")
  @@index([upload_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customer {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  erp_customer_id    Int?                      @unique(where: raw("(deleted_at IS NULL)"))
  personality        String?
  potential          String?
  name               String
  trade_name         String?
  establishment_type String?
  address            String?
  municipality       String?
  zone               String?
  phone              String?
  mobile             String?
  location           Unsupported("geography")?
  place_id           String?
  attends            String?
  credit             Boolean                   @default(false)
  credit_limit       Decimal?                  @db.Decimal(14, 2)
  origin             String?
  active             Boolean                   @default(true)
  created_at         DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?                 @db.Timestamptz(6)
  product_request    product_request[]
  route_customer     route_customer[]
  sale               sale[]
  scheduled_visit    scheduled_visit[]
  visit              visit[]
}

