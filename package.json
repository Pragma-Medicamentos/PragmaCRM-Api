{
  "name": "pragmacrm-api",
  "version": "1.0.0",
  "description": "API del CRM de Pragma Medicamentos",
  "main": "index.js",
  "scripts": {
    "dev": "tsnd --respawn --clear --files src/app.ts",
    "dev:debug": "tsnd --inspect --respawn --clear --files src/app.ts",
    "dev:token": "ts-node --transpile-only src/scripts/dev-token.ts",
    "build": "rimraf ./dist && tsc",
    "start": "npm run build && node dist/app.js",
    "lint": "eslint src/",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "keywords": [],
  "author": "Pragma Medicamentos",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.3.1",
    "env-var": "^7.4.1",
    "express": "^4.18.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  }
}
