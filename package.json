{
  "name": "pragmacrm-api",
  "version": "1.0.0",
  "description": "API del CRM de Pragma Medicamentos",
  "main": "index.js",
  "scripts": {
    "dev": "tsnd --respawn --clear src/app.ts",
    "build": "rimraf ./dist && tsc",
    "start": "npm run build && node dist/app.js",
    "lint": "eslint src/",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --no-seed",
    "db:new": "supabase migration new"
  },
  "keywords": [],
  "author": "Pragma Medicamentos",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/node": "^20.8.0",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "env-var": "^7.4.1",
    "express": "^4.18.2"
  }
}
