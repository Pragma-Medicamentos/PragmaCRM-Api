# STAGE: entorno a nivel de aplicacion, usado en la logica propia (dev | staging | prod).
# NODE_ENV: variable del ecosistema Node/Express. Usar "development" en local y
# "production" en todos los entornos remotos (staging y prod por igual) para que
# Express y las librerias se comporten correctamente. NO usar NODE_ENV=staging:
# las librerias no lo reconocen y caen en modo development.
STAGE=dev
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# Cadena de conexion a PostgreSQL.
# Por defecto apunta a la instancia local de Supabase (`npx supabase start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Business timezone (IANA name). Every local-day boundary is computed in it:
# ERP dates, visit day, metrics ranges. Optional, defaults to America/El_Salvador.
# Changing it re-attributes the whole history to different days. The server
# refuses to boot with an invalid zone.
BUSINESS_TIMEZONE=America/El_Salvador

# Max size (MB) of the ERP sales JSON on manual upload (RF-03).
# A monthly export is around 5 MB; 100 MB covers ~18 months of history at the
# current rate (~7 months if the team grows to 5 salespeople).
# Whatever proxy sits in front must allow a body this large. Traefik (Dokploy,
# on the VPS) has no limit by default; nginx caps at 1 MB and needs
# `client_max_body_size` raised. See docs/DEPLOY_DOKPLOY.md.
UPLOAD_MAX_FILE_SIZE_MB=100

# Days without a visit/purchase after which a customer counts as inactive
# (metrics panel, RF-09). Optional, defaults to 30 (provisional, CLAUDE.md 5.8).
# Each request can override it with ?inactivity_days=.
INACTIVITY_THRESHOLD_DAYS=30
# --- Supabase Auth ---
# Project URL. Issuer and JWKS endpoint are derived from it.
# Local stack: http://127.0.0.1:54321 (see `npx supabase status`).
SUPABASE_URL=http://127.0.0.1:54321

# service_role key: full RLS bypass, usable over HTTP from anywhere.
# Server only. Never in the web bundle or the APK.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API from a browser
# (the web dashboard). The Android app is unaffected: it never sends an
# Origin header, so this check does not apply to it.
# Optional on STAGE=dev only. On staging and prod it is required: without it
# the server refuses to boot instead of silently rejecting the dashboard.
CORS_ORIGIN=http://localhost:5173

# Static shared secret. Every request except /api/health must send it in the
# `x-api-key` header. Required: the server refuses to boot without it.
API_KEY=tu-api-key-secreta
