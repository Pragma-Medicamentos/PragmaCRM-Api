# STAGE: entorno a nivel de aplicacion, usado en la logica propia (dev | staging | prod).
# NODE_ENV: variable del ecosistema Node/Express. Usar "development" en local y
# "production" en todos los entornos remotos (staging y prod por igual) para que
# Express y las librerias se comporten correctamente. NO usar NODE_ENV=staging:
# las librerias no lo reconocen y caen en modo development.
STAGE=dev
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# Cadena de conexion a PostgreSQL.
# Por defecto apunta a la instancia local de Supabase (`npx supabase start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Max size (MB) of the ERP sales JSON on manual upload (RF-03).
# A monthly export is around 5 MB; 100 MB covers ~18 months of history at the
# current rate (~7 months if the team grows to 5 salespeople).
# When deploying, raise `client_max_body_size` in nginx to the same value: it
# caps at 1 MB by default and answers 413 before the request reaches the API.
UPLOAD_MAX_FILE_SIZE_MB=100
# --- Clerk (autenticacion) ---
# Dashboard de Clerk > API Keys. Usar las llaves de la instancia de desarrollo
# en local y las de produccion solo en el VPS.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

